# PostgreSQL
DATABASE_URL=postgresql+asyncpg://patch_radar:patch_radar@localhost:5432/patch_radar

# Redis
REDIS_URL=redis://localhost:6379/0

# Cisco openVuln OAuth2 (https://developer.cisco.com)
CISCO_CLIENT_ID=changeme
CISCO_CLIENT_SECRET=changeme

# Dell CSAF feed (public, override only if using a mirror)
DELL_CSAF_BASE_URL=https://www.dell.com/support/security/csaf

# HPE SDR feed
HPE_SDR_BASE_URL=https://support.hpe.com/hpesc/public/sdr

# NetScaler / Cloud Software Group bulletins
NETSCALER_BULLETIN_RSS_URL=https://support.citrix.com/csaf/rss

# VMware, Palo Alto, Fortinet feeds
VMWARE_ADVISORIES_URL=https://www.vmware.com/security/advisories.xml
PALOALTO_API_URL=https://security.paloaltonetworks.com/api/v1/advisories
FORTINET_RSS_URL=https://fortiguard.fortinet.com/rss/ir.xml

# Scheduling
INGESTION_INTERVAL_HOURS=6

# Auth (set to false in production and configure JWT_SECRET)
AUTH_DISABLED=true
JWT_SECRET=change-me-in-production-use-a-real-secret

# Webhook targets (leave empty to disable)
WEBHOOK_SLACK_URL=
WEBHOOK_TEAMS_URL=
WEBHOOK_GENERIC_URL=
WEBHOOK_PAGERDUTY_KEY=

# Cache TTL (seconds)
CACHE_TTL_PATCHES=300
CACHE_TTL_VENDORS=60

# API rate limiting (requests per minute per IP)
API_RATE_LIMIT_PER_MINUTE=120
